# Lovable Cloud / Supabase (auto-gerados — não editar manualmente)
VITE_SUPABASE_PROJECT_ID="seu_project_id"
VITE_SUPABASE_URL="https://seu_project_id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sua_anon_key_publica"

# Sentry — monitoramento de erros em produção
# Obtenha o DSN em: https://sentry.io  →  Settings  →  Projects  →  <seu projeto>  →  Client Keys (DSN)
# Deixe vazio para desativar o Sentry (o app continua funcionando normalmente).
VITE_SENTRY_DSN=seu_dsn_aqui
